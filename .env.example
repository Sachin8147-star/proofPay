# ---- shared server-side secrets (copy to .env at the repo root; NEVER commit .env) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_EXPLORER_URL=https://testnet.mstscan.com

# Contract deployment (use brand-new keys, never reuse a key that was ever pasted anywhere)
DEPLOYER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=          # signs attestations; fund it with a little testnet MST for gas
ARBITRATOR_ADDRESS=            # wallet that resolves disputes (use it in the admin dashboard)
REFUND_GRACE_SECONDS=259200

# Filled in after `npm run deploy`
ESCROW_ADDRESS=
INDEXER_START_BLOCK=           # block number of the deployment, so the indexer skips older blocks

# AI (Google Gemini). Server-side only: never put this in web/.env.local or any NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_CALLS_PER_HOUR=30
REQUIRE_VERIFIED_EMAIL=true    # users must confirm their email before the API accepts them
MAX_UPLOAD_MB=25               # delivered zip files
MAX_PROOF_MB=5
ENV=development                # set to production to hide /docs
GITHUB_TOKEN=                  # optional: higher GitHub rate limits / private repos you have access to
WEB_ORIGINS=http://localhost:3000,http://admin.localhost:3000

# Notifications and background keeper (all optional)
RESEND_API_KEY=                # enables email notifications
EMAIL_FROM=ProofPay <notifications@yourdomain.com>
APP_URL=http://localhost:3000  # used for links inside emails
RUN_KEEPER=true                # auto-release after the challenge window + reminders
